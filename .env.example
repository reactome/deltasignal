# DeltaSignal Environment Configuration
# Copy this file to .env and configure for your environment.
# This repo is the DeltaSignal engine + HTTP API; the UI lives in the
# WebsiteAngular workspace and talks to this API (see docs/API.md).

# Application Settings
JULIA_NUM_THREADS=4
JULIA_ENV=production

# API
API_BASE_URL=http://localhost:8080
# CORS: restrict to the UI's origin in a real deployment (default "*").
DS_CORS_ORIGIN=*

# Pre-generated Reactome pathway catalog for GET /api/pathways.
# Point this at the logic-network-generator output dir.
# PATHWAY_CATALOG=./data/catalog

# Logging
LOG_LEVEL=info

# Registry for image pushing
REGISTRY=deltasignal
VERSION=latest

# --- Reactome Neo4j (bench/analysis scripts only) ---------------------------
# Several analysis scripts query a LOCAL Reactome graph database. There is no
# default password: a credential literal in a public repository is still a
# credential literal, so these scripts now refuse to run until NEO4J_PASSWORD
# is set rather than silently trying a guess.
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
