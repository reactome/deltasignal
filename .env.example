# DeltaSignal Environment Configuration
# Copy this file to .env and configure for your environment

# Application Settings
JULIA_NUM_THREADS=4
JULIA_ENV=production
NODE_ENV=production

# Service URLs (for development)
API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000

# Database (if added in future)
# DATABASE_URL=postgresql://user:pass@localhost:5432/deltasignal

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_HEALTH_MONITOR=false

# SSL/TLS (for production)
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Performance Tuning
API_MEMORY_LIMIT=4G
FRONTEND_MEMORY_LIMIT=512M
PROXY_MEMORY_LIMIT=256M

# Registry for image pushing
REGISTRY=deltasignal
VERSION=latest