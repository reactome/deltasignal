# Frontend-specific Docker ignore
# Exclude unnecessary files from Docker build context

# Dependencies (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs (will be generated)
dist/
.vite/
coverage/

# Git and version control
.git
.gitignore
.github

# Documentation  
*.md
docs/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local development configs
docker-compose*.yml
Dockerfile*

# Test files and results
test/
*.test.js
jest.config.js
cypress/
.nyc_output/